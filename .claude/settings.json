{
  "permissions": {
    "allow": [
      "Bash(c3 run .claude/hooks/stop.py*)",
      "Bash(c3 run .claude/hooks/pre_tool.py*)",
      "Bash(c3 run .claude/hooks/pre_compact.py*)",
      "Bash(c3 run .claude/hooks/restore_session.py*)",
      "Bash(c3 run .claude/hooks/statusline.py*)",
      "Bash(c3 run .claude/hooks/recall_autorebuild.py*)",
      "Bash(c3 run .claude/skills/dev-workflow/scripts/detect_execution_verification.py*)",
      "Bash(c3 run .claude/skills/dev-workflow/scripts/review_hint_inject.py*)",
      "Bash(c3 run .claude/skills/dev-workflow/scripts/record_review_decision.py*)",
      "Bash(c3 run .claude/skills/dev-workflow/scripts/record_agent_outcome.py*)",
      "Bash(c3 run .claude/skills/init-session/scripts/session_guard.py*)",
      "Bash(c3 run .claude/skills/start/scripts/archive_reports.py)",
      "Bash(c3 run .claude/skills/start/scripts/archive_reports.py --phase *)",
      "Read(**)",
      "Grep(**)",
      "Edit(.claude/reports/**)",
      "Edit(.claude/memory/sessions/**)",
      "Edit(.claude/memory/**)",
      "Edit(.claude/agent-memory/**)",
      "Edit(.claude/rules/**)",
      "Edit(.claude/rules/promoted/**)",
      "Edit(.claude/skills/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/tmp/**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git rev-parse*)",
      "Bash(git tag*)",
      "Bash(git push origin main)",
      "Bash(git push origin v*)",
      "Bash(gh release create v*)",
      "Bash(gh release view v*)",
      "Bash(codex exec*)",
      "WebSearch"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**.env.*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "network": {
      "allowUnixSockets": [],
      "allowAllUnixSockets": false,
      "allowLocalBinding": false,
      "allowedDomains": []
    },
    "enableWeakerNestedSandbox": true
  },
  "statusLine": {
    "type": "command",
    "command": "c3 run \"${CLAUDE_PROJECT_DIR}/.claude/hooks/statusline.py\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_tool.py"]
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree_guard.py"]
          },
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/patterns_guard.py"]
          },
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_path_guard.py"]
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree_guard.py"]
          },
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/patterns_guard.py"]
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_agent_invocation.py"]
          },
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/tier_autoapply.py"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/post_tool.py"]
          },
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/planner_check.py"]
          },
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/report_contract_check.py"]
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/post_tool.py"]
          },
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/planner_check.py"]
          },
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_mode_watch.py"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/select_tier.py"]
          },
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/recall_inject.py"]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/restore_session.py"]
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py"]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_compact.py"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_stop.py"]
          },
          {
            "type": "command",
            "command": "c3",
            "args": ["run", "${CLAUDE_PROJECT_DIR}/.claude/hooks/recall_autorebuild.py"]
          }
        ]
      }
    ]
  }
}
